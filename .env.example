# ====== Modus ======
# "openrouter" = OpenRouter Cloud, kostenlos, kein PC nötig (empfohlen!)
# "local"      = komplett lokal & kostenlos (Whisper + Ollama, braucht PC/Mac)
# "groq"       = Groq Cloud, kostenlos (falls Registrierung klappt)
# "api"        = OpenAI Cloud (braucht API Key + Geld)
MODE=local

# ====== Notiz-Style ======
# classic   = Mit Emojis, übersichtlich (Standard)
# minimal   = Nur Text, kein Schnickschnack
# card      = Rezeptkarte mit Rahmen
# checklist = Zum Abhaken beim Kochen & Einkaufen
NOTE_STYLE=classic

# ====== OpenRouter (empfohlen — kostenlos!) ======
# Hol dir einen Key auf https://openrouter.ai/keys (Google-Login reicht)
OPENROUTER_API_KEY=sk-or-dein-key-hier
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ====== Groq (Alternative) ======
# GROQ_API_KEY=gsk_dein-key-hier
# GROQ_LLM_MODEL=llama-3.1-8b-instant

# ====== Lokal (falls MODE=local) ======
WHISPER_MODEL=base
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# ====== API (falls MODE=api) ======
# OPENAI_API_KEY=sk-your-api-key-here
# Dauerhafte Speicherung auf Render (Supabase → Project Settings → Database):
# DATABASE_URL=postgresql://postgres.PROJEKT:PASSWORT@HOST:6543/postgres
